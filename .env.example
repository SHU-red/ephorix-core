# EphoriX API — copy to .env and adjust. All values have sane defaults.
# `docker compose` reads this file automatically when placed next to it.

# --- Database --------------------------------------------------------------
EPHORIX_DB_USER=ephorix
EPHORIX_DB_PASSWORD=ephorix
EPHORIX_DB_NAME=ephorix
EPHORIX_DB_PORT=5432            # host port for the database (optional)
EPHORIX_PG_VOLUME=ephorix_pgdata  # named volume, or an absolute host path
# SELinux (RHEL/Fedora): set to z (shared) or Z (private) when
# EPHORIX_PG_VOLUME is a host bind mount. Leave empty otherwise — named
# volumes are already labeled by Docker and need no mode.
EPHORIX_VOLUME_MODE=
EPHORIX_TIMESCALE_TAG=latest-pg16

# Override the whole connection string if you changed names/ports or your
# password contains URL-reserved characters (@ : / ? #).
# EPHORIX_DATABASE_URL=postgres://user:pass@db:5432/ephorix

# --- API -------------------------------------------------------------------
EPHORIX_API_PORT=3000           # host port for the API
EPHORIX_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
EPHORIX_LOG_LEVEL=info,ephorix_api=debug
