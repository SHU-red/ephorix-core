# EphoriX — copy to .env and adjust. `docker compose` reads this file
# automatically when placed next to it.
#
# Topology: ONE exposed port (web) and ONE volume (database). The database
# and API are internal to the compose network; everything external — web UI,
# watch health data, markers — goes through the web service on port 9000.

# --- Database (internal only) ----------------------------------------------
EPHORIX_DB_USER=ephorix
EPHORIX_DB_PASSWORD=ephorix
EPHORIX_DB_NAME=ephorix
EPHORIX_PG_VOLUME=ephorix_pgdata  # named volume, or an absolute host path
# SELinux (RHEL/Fedora): set to z (shared) or Z (private) when
# EPHORIX_PG_VOLUME is a host bind mount. Leave empty otherwise.
EPHORIX_VOLUME_MODE=
EPHORIX_TIMESCALE_TAG=latest-pg16

# Override the whole connection string if you changed names or your password
# contains URL-reserved characters (@ : / ? #).
# EPHORIX_DATABASE_URL=postgres://user:pass@db:5432/ephorix

# --- Web (single entry point) ----------------------------------------------
EPHORIX_WEB_PORT=9000
EPHORIX_LOG_LEVEL=info,ephorix_api=debug

# --- Images (published to GHCR via scripts/publish.sh) ---------------------
# ONE tag for the whole product: api and web images always come from the
# same commit, so a single tag is a matched pair by construction.
# latest = latest release; dev = latest main build; both variants also
# carry commit locks (dev-<sha> for dev, <sha> for releases).
# `docker compose pull && docker compose up -d` pulls these; local builds
# still work via `docker compose up --build`.
EPHORIX_TAG=latest
